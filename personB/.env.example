# Copy this file to .env and fill in your real values.
# .env is where secrets live — it should NEVER be committed to GitHub.

# Your Supabase direct connection string (from Connect > Direct > Connection string).
# Replace [YOUR-PASSWORD] with your actual database password.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.fphpuyadffaxkgdkmeua.supabase.co:5432/postgres

# Your Supabase Project URL and keys (from Settings > API).
SUPABASE_URL=https://fphpuyadffaxkgdkmeua.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxx

# Redis, for Celery background tasks (set up later when you get to that step)
REDIS_URL=redis://localhost:6379/0
